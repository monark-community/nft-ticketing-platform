generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ORGANIZER
  SCANNER
  ADMIN
}

enum EventStatus {
  DRAFT
  FROZEN
  PUBLISHED
}

enum TicketStatus {
  VALID
  USED
}

model User {
  wallet_address String   @id
  nonce          String?
  first_name     String?
  last_name      String?
  role           Role     @default(USER)
  // Required by the app (collected as step 2 of account creation), but nullable
  // because the row is created at login, before the email step. See requireEmail.
  email          String?  @unique
  nickname       String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  organized_events Event[]      @relation("organizer")
  checkin_logs     CheckinLog[]
}

model Event {
  id                String      @id @default(uuid())
  organizer_wallet  String
  title             String
  description       String?
  location          String?
  category          String?
  start_date        DateTime
  end_date          DateTime?
  image_url         String?
  ipfs_hash         String?
  contract_event_id BigInt?     @unique
  status            EventStatus @default(DRAFT)
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt

  // Copied from the contract by the blockchain listener (#215, #299). The contract is the
  // source of truth: these are a cache for lists and dashboards. The settings stay null until the
  // event is published and its on-chain setup is copied.
  sale_active      Boolean   @default(false)
  presale_active   Boolean   @default(false)
  royalty_bps      Int? // organizer royalty on resales, 1000 = 10%
  resale_cap_bps   Int? // resale cap as % of face value, 20000 = 2x; 0 = no cap
  per_wallet_limit Int? // 0 = no limit
  sales_end_at     DateTime? // the contract's endTime: sales stop and the resale cap ends

  organizer    User         @relation("organizer", fields: [organizer_wallet], references: [wallet_address], onDelete: Restrict)
  ticket_types TicketType[]
  tickets      Ticket[]
  scanners     Scanner[]
  whitelist    Whitelist[]
  withdrawals  Withdrawal[]

  @@index([category])
}

model TicketType {
  id               String   @id @default(uuid())
  event_id         String
  name             String
  description      String?
  price            Decimal  @db.Decimal(18, 8)
  supply           Int
  sold             Int      @default(0)
  metadata         Json?
  ipfs_hash        String?
  // The type's ID on the contract (0, 1, 2, ...), set when it's added on-chain (#216)
  contract_type_id Int?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  event   Event    @relation(fields: [event_id], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@unique([event_id, contract_type_id])
}

model Ticket {
  token_id       BigInt       @id
  event_id       String
  ticket_type_id String
  owner_wallet   String
  status         TicketStatus @default(VALID)
  used_at        DateTime?
  minted_at      DateTime     @default(now())
  updated_at     DateTime     @updatedAt
  // Face value in USDC: the price paid, or the type's price for an issued ticket. The resale cap is based on it.
  face_value     Decimal?     @db.Decimal(18, 8)
  // What the buyer paid in USDC (#215). Null for tickets the organizer issued for free.
  purchase_price Decimal?     @db.Decimal(18, 8)
  mint_tx_hash   String?

  event        Event        @relation(fields: [event_id], references: [id], onDelete: Restrict)
  ticket_type  TicketType   @relation(fields: [ticket_type_id], references: [id], onDelete: Restrict)
  checkin_logs CheckinLog[]
  listing      Listing?

  @@index([owner_wallet])
}

// A ticket listed for resale on the platform (#299). One row per listed ticket; the row is
// removed when the listing is cancelled, the ticket is resold, transferred or checked in.
model Listing {
  token_id      BigInt   @id
  seller_wallet String
  price         Decimal  @db.Decimal(18, 8) // in USDC
  listed_at     DateTime
  tx_hash       String?

  ticket Ticket @relation(fields: [token_id], references: [token_id], onDelete: Cascade)

  @@index([price])
  @@index([listed_at])
}

// Revenue an organizer withdrew from an event (#215)
model Withdrawal {
  id               String   @id @default(uuid())
  event_id         String
  organizer_wallet String
  amount           Decimal  @db.Decimal(18, 8) // in USDC
  withdrawn_at     DateTime
  tx_hash          String?
  log_index        Int?

  event Event @relation(fields: [event_id], references: [id], onDelete: Cascade)

  // The same on-chain event is only recorded once, even when the listener sees it twice
  @@unique([tx_hash, log_index])
  @@index([event_id])
}

model Scanner {
  id              String   @id @default(uuid())
  event_id        String
  wallet          String
  assigned_by     String
  synced_to_chain Boolean  @default(false)
  created_at      DateTime @default(now())

  event Event @relation(fields: [event_id], references: [id], onDelete: Cascade)

  @@unique([event_id, wallet])
}

model Whitelist {
  id              String   @id @default(uuid())
  event_id        String
  wallet          String
  added_by        String
  synced_to_chain Boolean  @default(false)
  created_at      DateTime @default(now())

  event Event @relation(fields: [event_id], references: [id], onDelete: Cascade)

  @@unique([event_id, wallet])
}

model CheckinLog {
  id             String   @id @default(uuid())
  token_id       BigInt
  scanner_wallet String
  checked_in_at  DateTime @default(now())

  ticket  Ticket @relation(fields: [token_id], references: [token_id], onDelete: Restrict)
  scanner User   @relation(fields: [scanner_wallet], references: [wallet_address], onDelete: Restrict)
}
