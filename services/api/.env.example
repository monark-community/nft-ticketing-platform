# Server
API_PORT=3001
NODE_ENV=development

# Database (PostgreSQL on Render)
DATABASE_URL="postgresql://ticketing_user:ticketing_password@localhost:5432/nft_ticketing?schema=public"

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=1h

# Pinata IPFS (JWT only, used by PinataSDK)
PINATA_JWT=your_pinata_jwt_token
# Optional, defaults to gateway.pinata.cloud
PINATA_GATEWAY=gateway.pinata.cloud

# Blockchain
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_key
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# The block the contract was deployed in (deployBlock in services/web/src/contracts/addresses.json).
# The listener reads the contract's events from there the first time, then carries on from the last
# block it read. Leave it empty for a local node, which is read from block 0.
CONTRACT_DEPLOY_BLOCK=
CHAIN_ID=11155111

# CORS
FRONTEND_URL=http://localhost:3000
