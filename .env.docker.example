# Docker-specific environment variables
# Copy this file to .env and update values as needed for Docker deployment

# Node Environment
NODE_ENV=development

# Database Configuration
POSTGRES_USER=ticketing_user
POSTGRES_PASSWORD=ticketing_password
POSTGRES_DB=nft_ticketing
POSTGRES_PORT=5432
POSTGRES_ENVIRONMENT=dev

# Prisma
DATABASE_URL=postgresql://ticketing_user:ticketing_password@db:5432/nft_ticketing?schema=public

# API Configuration
API_PORT=3001

# Web/Frontend Configuration
WEB_PORT=3000
# WalletConnect Cloud project ID required by RainbowKit. The compose file defaults
# to a placeholder that lets the app boot; set a real ID from https://cloud.reown.com
# for wallet connections to actually work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=local-dev-placeholder

# Add other configuration variables here
# SMART_CONTRACT_ADDRESS=
# WALLET_ADDRESS=
